# Application Environment
# Set to True for development environment and False for production environment
DEBUG=False

# Logging Configuration
# Set the desired logging level. Options are:
# DEBUG   - Detailed information, typically for troubleshooting
# INFO    - General operational information
# WARNING - Indicates potential issues or important situations
# ERROR   - Errors that might require attention
# CRITICAL - Severe errors that likely result in a crash or failure
LOG_LEVEL=INFO

# Model / inference
MODEL_NAME=facebook/detr-resnet-50
# MODEL_REVISION=abc123def456
CONFIDENCE_THRESHOLD=0.5
INFERENCE_DEVICE=cpu
MAX_IMAGE_DIMENSION=1333
WARMUP_ON_STARTUP=True

# To set up your environment, copy the example configuration to a new .env file:
# cp .env.example .env

# Edit the .env file with appropriate values for your project environment:
# - Set DEBUG to True for development or False for production
# - Choose an appropriate LOG_LEVEL (e.g., DEBUG for troubleshooting or INFO for general logs)
