# Application
# APP_VERSION=1.0.0

# Logging — DEBUG for local troubleshooting, INFO for production
LOG_LEVEL=INFO

# Storage paths (defaults shown; override only if needed)
# UPLOADED_FOLDER=app/static/uploaded
# EDITED_FOLDER=app/static/edited
# DETECTED_FOLDER=app/static/detected

# Upload limits
MAX_UPLOAD_SIZE_MB=5

# Model / inference
MODEL_NAME=facebook/detr-resnet-50
# MODEL_REVISION=abc123def456
CONFIDENCE_THRESHOLD=0.5
INFERENCE_DEVICE=cpu
MAX_IMAGE_DIMENSION=1333
WARMUP_ON_STARTUP=True
MAX_CONCURRENT_INFERENCES=2

# Database
DATABASE_URL=sqlite:///./app/data/images.db

# Setup:
#   cp .env.example .env
# Then adjust LOG_LEVEL / INFERENCE_DEVICE for your environment.
