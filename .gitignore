# Ignore virtual environment and cache files
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# Ignore logs and temporary files
logs/
*.log

# Ignore .env file
.env

# Internal README rewrite notes (not for publication)
README_NOTES.md

# Packaging / build artifacts
*.egg-info/
dist/
build/
.eggs/

# Ignore pytest cache, coverage, type-checker, and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/

# Ignore image uploads, edited, and detected
app/static/uploaded/
app/static/edited/
app/static/detected/

# SQLite database files
app/data/
